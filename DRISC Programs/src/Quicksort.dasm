.define print_wait_time 200 //for logisim simulation set this number to 200, for FPGA at 25MHz set to 12500000
	nop
	lui sp 0xf				//inicializing stack pointer
:program_start
	la a0 .arr			    //"arr=" string
	li a1 4 				//size
	call :print_data

	la a0 .array			//array address
	li a1 16				//size
	call :print_data

	la a0 .array			//array address
	mv a1 zero				//low index, starts as 0
	li a2 15				//high index, starts as the last index	
	call :quickSort			//
	
	la a0 .result			//"res=" string
	li a1 4 				//size
	call :print_data
	
	la a0 .array			//array address
	li a1 16				//size
	call :print_data
	
	//reset the array
	la a0 .backup_array
	la a1 .array
	li a2 16
	call :copy_data

	jump :program_start		//program end


#REGION quicksort
:quickSort
	bge a1 a2 :end_quick_sort //if low >= high, return

	dec sp 16				//alocate 5 words of space
	sw ra sp 12				//Saves the registers that will be used
	sw s3 sp 8			
	sw s2 sp 4
	sw s1 sp 0

	mv s1 a1				//Passes the input arguments to the
	mv s2 a2				//Saved Registers

	call :partition			//p = partition(low,high);
	mv s3 a3				//

	mv a1 s1				//low
	addi a2 s3 -1			//pivot - 1			
	call :quickSort			//quicksort(array, low, pivot - 1)
	addi a1 s3 1			//pivot + 1
	mv a2 s2				//high	
	call :quickSort			//quickSort(array, pivot+1, high)
		
	lw s1 sp 0				//loads the saved registers from the
	lw s2 sp 4				//lower window
	lw s3 sp 8
	lw ra sp 12
	inc sp 16				//desalocate the 5 words

:end_quick_sort	
	ret

#ENDREGION

#REGION partition
:partition//translated from https://www.geeksforgeeks.org/quick-sort-algorithm/
	add t0 a0 a2			//&arr + high
	lb t0 t0 0				//pivot = arr[high]
	addi t1 a1 -1			//i = low - 1

	mv t2 a1				//for(j = low;..
	addi s9 a2 -1			//high - 1;
:for_start
	bgt t2 s9 :for_end		//..;j <= high - 1;..

	add t4 a0 t2			//&arr + j
	lb t6 t4 0				//arr[j]
	nop
	bge t6 t0 :end_if		//if(arr[j] < pivot){

	inc t1 1			//i++;
	//swap
	add t3 a0 t1			//&arr + i
	lb t5 t3 0				//arr[i]
	sb t6 t3 0				//arr[i] = j
	sb t5 t4 0				//arr[j] = i
:end_if
	inc t2 1			//..;j++){
	jump :for_start

:for_end

	//last swap
	addi t1 t1 1			//i+1;
	add t3 a0 t1			//&arr+i+1
	lb t5 t3 0				//arr[i+1]
	add t4 a0 a2			//&arr + high
	lb t6 t4 0				//arr[high]
	sb t5 t4 0				//arr[high] = i+1
	sb t6 t3 0				//arr[i+1] = high

	mv a3 t1				//return i+1 as the position of the pivot
	ret


#ENDREGION

#REGION print_data
	//print_data (int source_addr, int size)
:print_data
	mv t0 a0	     //source_addr
	li t1 0x01100010 //hex display address
	li t2 print_wait_time		 //counter between prints
	mv t3 t0
	add t3 t3 a1	 //final source_addr offset
	inc t3 4 		 //hack to clear the screen after printing
:print_data_loop	 //wait
	dec t2 1
	bne t2 zero :print_data_loop 	
	lw t5 t0 0 
	sw t5 t1 0 	//prints
	
	li t2 print_wait_time	//reset counter
	inc t0 4 	//shift one byte
	blt t0 t3 :print_data_loop
:print_data_end
	ret
#ENDREGION

#REGION copy_data
:copy_data
    //reset_data(int source_addr, int target_addr, int size)
	mv t0 a0 //t0 = endereço original
	mv t2 a1 //t2 = endereço alvo
	mv t3 zero //contador
:copy_data_loop
	lw t1 t0 0 //t1 = valor[endereço original]
 	sw t1 t2 0 //[endereço alvo] <= valor	
	inc t0 4
	inc t2 4
	inc t3 4 //endereço string ++
	beq t3 a2 :copy_data_end //enquanto menor que o tamanho
	jump :copy_data_loop
:copy_data_end
	ret
#ENDREGION

#REGION data
	.word 0x00000000 0x00000000 0x000000000 0x00000000
	.string array "e63fdc79b41a0258"
	.word 0x00000000 0x00000000 0x00000000
	.string backup_array "e63fdc79b41a0258"
	.string arr "arr="
	.string result "res="